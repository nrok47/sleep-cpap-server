server {
  listen 443 ssl;
  server_name sleep.example.go.th;          # เปลี่ยนเป็นโดเมนจริง
  ssl_certificate     /etc/ssl/certs/your.crt;
  ssl_certificate_key /etc/ssl/private/your.key;
  client_max_body_size 1m;
  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;   # ใช้ร่วมกับ TRUST_PROXY=1
    proxy_set_header X-Forwarded-Proto https;
  }
}
server { listen 80; server_name sleep.example.go.th; return 301 https://$host$request_uri; }
